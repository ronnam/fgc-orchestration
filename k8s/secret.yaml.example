apiVersion: v1
kind: Secret
metadata:
  name: fgc-users-api-secret
  namespace: fgc
type: Opaque
stringData:
  ConnectionStrings__UserDb: "<definido via GitHub Secrets: USERS_USERDB>"
  Jwt__Key: "<definido via GitHub Secrets: JWT_KEY>"
